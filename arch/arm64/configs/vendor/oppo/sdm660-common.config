# Auto local version
CONFIG_LOCALVERSION_AUTO=y

# Charger
# CONFIG_QPNP_QNOVO is not set

# Crypto
CONFIG_CRYPTO_LZ4=y

# Filesystem
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION=y

# HID
CONFIG_HID_BETOP_FF=y
CONFIG_SONY_FF=y

# Haptics
CONFIG_INPUT_JOYSTICK=y
# CONFIG_INPUT_HBTP_INPUT is not set
CONFIG_JOYSTICK_XPAD=y
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# Loop block
CONFIG_BLK_DEV_LOOP_MIN_COUNT=40

# Network
CONFIG_BPF_JIT=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_SOCKEV_NLMCAST=y

# Memory
CONFIG_PGTABLE_MAPPING=y

# Power
CONFIG_QCOM_PRESERVE_MEM=y

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# QCACLD
CONFIG_QCA_CLD_WLAN=y

# Ramdisk
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_RD_LZ4=y

# Sched
CONFIG_SCHEDSTATS=y

# Sound
CONFIG_SND_SOC_AK4376=y
CONFIG_SND_SOC_TFA98XX=y

# Slub debug
# CONFIG_SLUB_DEBUG is not set
