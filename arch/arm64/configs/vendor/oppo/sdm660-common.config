# Backlight
CONFIG_MFD_TI_LMU=y
CONFIG_BACKLIGHT_LM3697=y

# DTS
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y

# F2FS
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y

# Haptics
# CONFIG_INPUT_QTI_HAPTICS is not set
CONFIG_QPNP_HAPTIC=y

# ION
CONFIG_ION_LEGACY=y

# Init
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# OPPO
CONFIG_OPPO_ARCH_FILE=y
CONFIG_OPPO_COMMON_SOFT=y
CONFIG_OPPO_DEVICE_INFO=y

# UART
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y

# Touchscreen
CONFIG_TOUCHPANEL_OPPO=y
CONFIG_TOUCHPANEL_SYNAPTICS=y
CONFIG_TOUCHPANEL_SYNAPTICS_S3508=y
CONFIG_TOUCHPANEL_SYNAPTICS_S3320=y
CONFIG_TOUCHIRQ_UPDATE_QOS=y

# Wi-Fi
CONFIG_QCA_CLD_WLAN=y

# Fingerprint
CONFIG_OPPO_FINGERPRINT=y

# Charger
# CONFIG_SMB135X_CHARGER is not set
# CONFIG_SMB1351_USB_CHARGER is not set
# CONFIG_SMB138X_CHARGER is not set
# CONFIG_QPNP_QNOVO is not set
# CONFIG_QPNP_QNOVO5 is not set
# CONFIG_QPNP_FG_GEN3 is not set

# Re:Kernel
CONFIG_REKERNEL=y

# BBR
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"

# ZRAM Backend
# CONFIG_ZRAM_BACKEND_LZO is not set
# CONFIG_ZRAM_BACKEND_LZ4 is not set
# CONFIG_ZRAM_BACKEND_LZ4HC is not set
# CONFIG_ZRAM_BACKEND_ZSTD is not set
CONFIG_ZRAM_DEF_COMP_LZ4=y
CONFIG_ZRAM_DEF_COMP="lz4"

# LZ4HC
CONFIG_CRYPTO_LZ4HC=y

# TCP and WESTWOOD
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_WESTWOOD=y

# Droidspaces/Docker/LXC
#  CONFIG_ANDROID_PARANOID_NETWORK is not set
CONFIG_DOCKER=y
